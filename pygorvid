generate=false
for arg in "$@"
do
    case "$arg" in
        --generate|--generate=*) generate=true ;;
    esac
done
for d in c r g p
do
    if "$generate"; then
        time "$d/pygorvid" "$@"
    else
        time "$d/pygorvid" --prefix "j${d}_" "$@"
    fi
done
