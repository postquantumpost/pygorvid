execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy "${VIDPROBE}" --slideshow "${FIXTURE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(ENABLED)
    if(NOT status EQUAL 0 OR NOT output MATCHES "displayed 3 frames")
        message(FATAL_ERROR "Slideshow failed: ${status} ${output} ${error}")
    endif()
else()
    if(NOT status EQUAL 1 OR NOT error MATCHES "optional slideshow build feature was not included")
        message(FATAL_ERROR "Disabled slideshow was not reported: ${status} ${output} ${error}")
    endif()
endif()
foreach(option --readall --output --extractframe --generate)
    if(option STREQUAL "--output" OR option STREQUAL "--generate")
        set(value "output.mp4")
    elseif(option STREQUAL "--extractframe")
        set(value 0)
    else()
        set(value "")
    endif()
    execute_process(COMMAND "${VIDPROBE}" --slideshow "${FIXTURE}" "${option}" ${value}
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(NOT status EQUAL 2)
        message(FATAL_ERROR "Slideshow accepted conflicting option ${option}: ${status}")
    endif()
endforeach()
